{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(**/*.env)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(**/.idea/dataSources.local.xml)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.*.local)",
      "Edit(**/*.env)",
      "Edit(**/.dev.vars)",
      "Edit(**/.dev.vars.*)",
      "Bash(cat *.env*)",
      "Bash(cat */.env*)"
    ]
  }
}
