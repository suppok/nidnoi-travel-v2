APP_ENV=local
PORT=8080

# Supabase session pooler (aws-*.pooler.supabase.com:5432)
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

JWT_SECRET=<random-64-char-string>

CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:5174

# The URL itself is the credential
CLOUDFLARE_DEPLOY_HOOK_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nidnoi-travel-media-dev
R2_PUBLIC_URL=https://dev-media.nidnoitravelv2.com

# LINE OA — Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login channel (same provider as the Messaging API channel): enables "ล็อกอินด้วย LINE" and
# "เชื่อมบัญชี LINE" in the backoffice.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
