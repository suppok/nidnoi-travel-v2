                ],
                "responses": {
                    "200": {
                        "description": "data: null",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "VALIDATION, INVALID_PASSWORD",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
