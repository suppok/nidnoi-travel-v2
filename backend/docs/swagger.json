                    "401": {
                        "description": "UNAUTHENTICATED",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/auth/password": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Clears mustChangePassword and signs out every other session.",
