<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ยืนยันการจอง {{.BookingNo}}</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f4f4;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f4f4;">
  <tr>
    <td align="center" style="padding:24px 12px;">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background-color:#ffffff;border:1px solid #e0e0e0;font-family:Tahoma,Arial,sans-serif;font-size:15px;line-height:1.6;color:#222222;">
        <tr>
          <td style="padding:20px 24px;border-bottom:3px solid #1f6f50;">
            <div style="font-size:18px;font-weight:bold;color:#1f6f50;">ยืนยันการจองและการชำระเงิน</div>
            <div style="font-size:14px;color:#666666;">เลขที่การจอง {{.BookingNo}}</div>
          </td>
        </tr>
        <tr>
          <td style="padding:20px 24px 8px 24px;">
            เรียน {{if .WholesaleName}}{{.WholesaleName}}{{else}}ฝ่ายจอง{{end}}<br>
            นิดหน่อย ทราเวล ขอยืนยันการจองด้านล่าง ลูกค้าได้ชำระเงินแล้ว
          </td>
        </tr>
        <tr>
          <td style="padding:8px 24px;">
            <table role="presentation" width="100%" cellpadding="6" cellspacing="0" border="0" style="border-collapse:collapse;font-size:15px;">
              <tr><td style="width:40%;color:#666666;border-bottom:1px solid #eeeeee;">เลขที่การจอง</td><td style="border-bottom:1px solid #eeeeee;font-weight:bold;">{{.BookingNo}}</td></tr>
              <tr><td style="color:#666666;border-bottom:1px solid #eeeeee;">รหัสทัวร์</td><td style="border-bottom:1px solid #eeeeee;">{{.TourCode}}</td></tr>
              <tr><td style="color:#666666;border-bottom:1px solid #eeeeee;">ชื่อทัวร์</td><td style="border-bottom:1px solid #eeeeee;">{{.TourName}}</td></tr>
              <tr><td style="color:#666666;border-bottom:1px solid #eeeeee;">วันเดินทาง</td><td style="border-bottom:1px solid #eeeeee;">{{.StartDate}} – {{.EndDate}}</td></tr>
              {{if .CustomerName}}<tr><td style="color:#666666;border-bottom:1px solid #eeeeee;">ชื่อลูกค้า</td><td style="border-bottom:1px solid #eeeeee;">{{.CustomerName}}</td></tr>{{end}}
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding:16px 24px 8px 24px;font-weight:bold;">จำนวนผู้เดินทาง</td>
        </tr>
        <tr>
          <td style="padding:0 24px 8px 24px;">
            <table role="presentation" width="100%" cellpadding="6" cellspacing="0" border="0" style="border-collapse:collapse;font-size:15px;">
              {{range .Travellers}}<tr><td style="width:40%;color:#666666;border-bottom:1px solid #eeeeee;">{{.Label}}</td><td style="border-bottom:1px solid #eeeeee;">{{.Count}} ท่าน</td></tr>
              {{end}}<tr><td style="color:#666666;">รวม</td><td style="font-weight:bold;">{{.TotalTravellers}} ท่าน</td></tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding:16px 24px 8px 24px;">
            <table role="presentation" width="100%" cellpadding="6" cellspacing="0" border="0" style="border-collapse:collapse;font-size:15px;background-color:#f1f8f4;">
              <tr><td style="width:40%;color:#666666;">ยอดรวม</td><td>{{baht .TotalPrice}} บาท</td></tr>
              <tr><td style="color:#666666;">{{if .IsDeposit}}ยอดมัดจำที่ชำระแล้ว{{else}}ยอดที่ชำระแล้ว (เต็มจำนวน){{end}}</td><td style="font-weight:bold;color:#1f6f50;">{{baht .PaidAmount}} บาท</td></tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding:16px 24px 24px 24px;">
            รบกวนตอบกลับอีเมลนี้เพื่อยืนยันว่าได้รับการจองเรียบร้อยแล้ว ขอบคุณค่ะ<br><br>
            {{if .SalesName}}{{.SalesName}}<br>{{end}}นิดหน่อย ทราเวล
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
