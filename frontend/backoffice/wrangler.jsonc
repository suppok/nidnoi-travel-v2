// Workers static assets only, SPA fallback
{
  "name": "backoffice",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "dev": { "name": "backoffice-dev" },
    "prd": { "name": "backoffice-prd" }
  }
}
