---
import { SITE_NAME } from '../../lib/seo';

const links = [
  { href: '/tour-programs/', label: 'โปรแกรมทัวร์' },
  { href: '/about/', label: 'เกี่ยวกับเรา' },
  { href: '/contact/', label: 'ติดต่อเรา' },
];
---

<header class="sticky top-0 z-10 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="text-xl font-bold text-primary-800">{SITE_NAME}</a>
    <nav aria-label="เมนูหลัก">
      <ul class="flex gap-4 text-sm sm:gap-6 sm:text-base">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="text-slate-700 hover:text-primary-700">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
