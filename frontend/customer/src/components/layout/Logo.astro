---
import { Image } from 'astro:assets';
import logo from '../../assets/nidnoi-logo.png';
import { SITE_NAME } from '../../lib/seo';

type Props = { height?: number; class?: string };
const { height = 64, class: className } = Astro.props;
const width = Math.round((logo.width / logo.height) * height);
---

<a href="/" class:list={['inline-flex shrink-0 items-center', className]} aria-label={`${SITE_NAME} หน้าแรก`}>
  <Image src={logo} alt={SITE_NAME} width={width} height={height} densities={[1, 2]} loading="eager" />
</a>
