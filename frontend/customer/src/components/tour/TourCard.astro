---
import { discountPercent, formatDate, formatDuration, formatPrice } from '../../lib/format';
import type { TourProgramPublicItem } from '../../types/tour-program';
import CfImage from '../ui/CfImage.astro';
import Icon from '../ui/Icon.astro';

type Props = {
  tour: TourProgramPublicItem;
  /** Matches the grid the card sits in, for the image `sizes` hint. */
  columns?: 3 | 4;
  headingLevel?: 'h2' | 'h3';
};

const { tour, columns = 4, headingLevel: Heading = 'h3' } = Astro.props;
const discount =
  tour.startingPrice !== null ? discountPercent(tour.startingPrice, tour.startingPriceBeforeDiscount) : 0;
const place = [tour.countries[0]?.nameTh, tour.cities[0]?.nameTh].filter(Boolean).join(' · ');
const sizes =
  columns === 4
    ? '(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw'
    : '(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw';
---

<article class="tour-card relative flex w-full flex-col overflow-hidden rounded-lg border border-line-soft bg-white">
  <div class="relative aspect-[4/5] overflow-hidden bg-cream-deep">
    {
      tour.cardImage && (
        <CfImage
          src={tour.cardImage}
          alt=""
          preset="card"
          width={400}
          height={500}
          sizes={sizes}
          class="tour-card-img absolute inset-0 h-full w-full object-cover"
        />
      )
    }
    <div class="absolute inset-0 bg-gradient-to-b from-transparent from-55% to-ink/45"></div>

    {
      discount > 0 && (
        <div class="discount-badge absolute top-3.5 right-3.5 flex h-12 w-12 flex-col items-center justify-center rounded-full bg-accent-deep text-white">
          <span class="text-[9px] leading-none font-semibold tracking-wider">ลด</span>
          <span class="mt-0.5 font-display text-sm leading-none font-semibold">{discount}%</span>
        </div>
      )
    }

    {
      place && (
        <span class="chip chip-light absolute bottom-3.5 left-3.5 text-[12px]">
          <Icon name="map-pin" size={12} class="text-primary-deep" /> {place}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col px-5 pt-4 pb-5">
    <div class="mb-2.5 flex items-center gap-2.5 text-[13px] text-ink-muted">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="calendar" size={13} />
        {formatDuration(tour.days, tour.nights)}
      </span>
      {
        tour.airline && (
          <>
            <span class="h-[3px] w-[3px] rounded-full bg-ink-muted" aria-hidden="true" />
            <span class="inline-flex items-center gap-1.5" title={tour.airline.name}>
              <Icon name="plane" size={13} />
              {tour.airline.code}
            </span>
          </>
        )
      }
    </div>

    <Heading class="mb-1.5 font-display text-[17px] leading-snug font-semibold text-ink">
      <a href={`/tour/${tour.code}/`} class="tour-card-link">{tour.name}</a>
    </Heading>
    {tour.highlight && <p class="mb-4 line-clamp-2 text-sm leading-relaxed text-ink-muted">{tour.highlight}</p>}

    <div class="mt-auto flex items-end justify-between border-t border-line-soft pt-3.5">
      {
        tour.startingPrice !== null ? (
          <div>
            <div class="mb-0.5 text-xs font-medium text-ink-muted">ราคาเริ่มต้น</div>
            <div class="flex items-baseline gap-1.5">
              <span class="font-display text-2xl leading-none font-semibold text-primary-deep">
                {formatPrice(tour.startingPrice)}
              </span>
              <span class="text-sm font-medium text-ink-muted">บาท</span>
            </div>
            {discount > 0 && tour.startingPriceBeforeDiscount && (
              <div class="mt-0.5 text-xs text-ink-muted line-through">
                {formatPrice(tour.startingPriceBeforeDiscount)} บาท
              </div>
            )}
          </div>
        ) : (
          <div class="text-sm font-medium text-ink-muted">สอบถามราคา</div>
        )
      }
      <span class="tour-cta flex h-10 w-10 items-center justify-center rounded-full bg-primary-tint text-primary-deep" aria-hidden="true">
        <Icon name="arrow-up-right" size={15} />
      </span>
    </div>

    <p class="mt-3 text-xs font-medium text-ink-muted">
      รหัส {tour.code.toUpperCase()} · {tour.periodCount} รอบเดินทาง
      {tour.nextDepartureDate && <> · เริ่ม {formatDate(tour.nextDepartureDate)}</>}
    </p>
  </div>
</article>

<style>
  .tour-card {
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }
  /* The whole card is clickable through the title link's overlay. */
  .tour-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .tour-card:hover,
  .tour-card:focus-within {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-line);
  }
  .tour-card-img {
    transition: transform 0.6s ease;
  }
  .tour-card:hover .tour-card-img {
    transform: scale(1.05);
  }
  .tour-cta {
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .tour-card:hover .tour-cta {
    background: var(--color-primary-deep);
    color: var(--color-white);
  }
  .discount-badge {
    box-shadow: var(--shadow-accent);
  }
</style>
