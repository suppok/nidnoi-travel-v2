---
// Inline stroke icons from the design (24×24 grid). Decorative by default (aria-hidden).
export type IconName = keyof typeof PATHS | keyof typeof FILLED;

type Props = { name: IconName; size?: number; class?: string; label?: string };

const PATHS = {
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  phone: '<path d="M5 4h4l2 5-2 1c1 2 3 4 5 5l1-2 5 2v4a2 2 0 0 1-2 2A14 14 0 0 1 5 6a2 2 0 0 1 2-2"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  'arrow-right': '<path d="M5 12h14m-6-6 6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M9 7h8v8"/>',
  'chevron-right': '<path d="m9 6 6 6-6 6"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  users: '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14a5 5 0 0 1 5 5"/>',
  plane: '<path d="M10 16 4 18l-1-2 6-4-1-7 2-1 4 7 6-1 1 2-6 4-1 7-2 1-2-6Z"/>',
  'map-pin': '<path d="M12 21s7-6 7-12a7 7 0 1 0-14 0c0 6 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/>',
  shield: '<path d="M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/>',
  headset: '<path d="M4 13v-2a8 8 0 1 1 16 0v2"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M17 19a4 4 0 0 1-4 4h-1"/>',
  medal: '<circle cx="12" cy="14" r="6"/><path d="M8 4 12 10 16 4M8 4h8"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m9 15 1.5-4.5L15 9l-1.5 4.5Z"/>',
  wallet: '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18M17 14h1"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/>',
  youtube: '<rect x="2" y="6" width="20" height="12" rx="3"/><path d="m10 9 5 3-5 3z"/>',
} as const;

// Brand glyphs are filled, not stroked.
const FILLED = {
  line: '<path d="M12 3C6.48 3 2 6.58 2 11c0 2.74 1.74 5.13 4.36 6.55-.13.5-.86 3.06-.88 3.16 0 0-.02.15.08.21s.21 0 .21 0c.27-.04 3.13-2.05 3.6-2.39.85.12 1.71.18 2.63.18 5.52 0 10-3.58 10-8s-4.48-7.7-10-7.7Z"/>',
  facebook: '<path d="M13.5 21v-7h2.4l.4-3h-2.8V9c0-.9.3-1.5 1.5-1.5h1.4V4.9c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.4-3.7 3.8V11H8v3h2.5v7z"/>',
  tiktok: '<path d="M14 4v9.5a2.5 2.5 0 1 1-2.5-2.5h.5V8a5.5 5.5 0 1 0 5.5 5.5V9a6 6 0 0 0 3 1V7a3 3 0 0 1-3-3z"/>',
} as const;

const { name, size = 16, class: className, label } = Astro.props;
const filled = name in FILLED;
const body = filled ? FILLED[name as keyof typeof FILLED] : PATHS[name as keyof typeof PATHS];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  class:list={['shrink-0', className]}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
