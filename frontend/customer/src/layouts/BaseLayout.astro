---
import { env } from '../config/env';
import { absoluteUrl, defaultOgImage, pageTitle, SITE_NAME, type SeoProps } from '../lib/seo';
import '../styles/global.css';

type Props = SeoProps;

const { title, description, path, ogImage = defaultOgImage(), ogType = 'website', jsonLd = [], noindex = false } = Astro.props;
const fullTitle = pageTitle(title);
const canonical = absoluteUrl(path);
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e6f3fb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {env.SITE_ENV !== 'prd' ? <meta name="robots" content="noindex, nofollow" /> : noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="th_TH" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}

    <slot name="head" />
    <!-- Scroll reveal: content is hidden only when the observer can show it again (no JS or reduced motion → always visible). -->
    <script is:inline>
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
  </head>
  <body class="min-h-screen bg-white">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
      >ข้ามไปยังเนื้อหา</a
    >
    <slot />
    <script>
      // Fades in [data-reveal] blocks and the children of [data-reveal-stagger] lists as they scroll into view.
      if (document.documentElement.classList.contains('js-reveal')) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        for (const el of document.querySelectorAll<HTMLElement>('[data-reveal]')) observer.observe(el);
        for (const list of document.querySelectorAll<HTMLElement>('[data-reveal-stagger]')) {
          Array.from(list.children).forEach((child, i) => {
            (child as HTMLElement).style.setProperty('--reveal-delay', `${(i % 4) * 90}ms`);
            observer.observe(child);
          });
        }
      }
    </script>
  </body>
</html>
