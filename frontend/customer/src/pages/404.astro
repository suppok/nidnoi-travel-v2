---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="ไม่พบหน้าที่คุณต้องการ"
  description="ไม่พบหน้าที่คุณต้องการ หน้านี้อาจถูกย้ายหรือลบไปแล้ว กลับไปหน้าแรกเพื่อดูโปรแกรมทัวร์ต่างประเทศทั้งหมดของเรา"
  path="/404/"
>
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-6xl font-bold text-primary-700">404</p>
    <h1 class="mt-4 text-2xl font-bold">ไม่พบหน้าที่คุณต้องการ</h1>
    <p class="mt-2 text-slate-600">หน้านี้อาจถูกย้ายหรือลบไปแล้ว</p>
    <a href="/" class="mt-8 inline-block font-semibold text-primary-700 underline">กลับหน้าแรก</a>
  </section>
</PageLayout>
