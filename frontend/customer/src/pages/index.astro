---
import Destinations from '../components/home/Destinations.astro';
import FireSales from '../components/home/FireSales.astro';
import Hero from '../components/home/Hero.astro';
import PromiseStrip from '../components/home/PromiseStrip.astro';
import TourCard from '../components/tour/TourCard.astro';
import Icon from '../components/ui/Icon.astro';
import LineCta from '../components/ui/LineCta.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { heroCampaign } from '../config/home';
import { env } from '../config/env';
import { mockFireSales, pickFireSales } from '../lib/fire-sales';
import { byNextDeparture, listPublicTours } from '../lib/api/tour-programs';
import { listPublicCities, listPublicCountries } from '../lib/api/taxonomy';
import { ogImageUrl } from '../lib/image';
import { SITE_NAME } from '../lib/seo';
import PageLayout from '../layouts/PageLayout.astro';

const FEATURED_LIMIT = 8;

const [countries, cities, tours] = await Promise.all([listPublicCountries(), listPublicCities(), listPublicTours()]);
const activeCountries = countries.filter((c) => c.tourCount > 0);
const activeCities = cities.filter((c) => c.tourCount > 0 && activeCountries.some((x) => x.slug === c.countrySlug));
// Without tours in the campaign country the hero drops its price and links to the destination list.
const heroCountry = activeCountries.find((c) => c.slug === heroCampaign.countrySlug);
const realFireSales = pickFireSales(tours);
// โปรไฟไหม้ replaces the upcoming-tours row; that row returns only while staff have no promo switched on.
const featured = realFireSales.length === 0 ? [...tours].sort(byNextDeparture).slice(0, FEATURED_LIMIT) : [];
// Off prd, preview the section with mock promos (fake discounts) until staff flag real ones.
// It never runs on prd, and the upcoming-tours row stays visible on dev so both can be reviewed.
const fireSales = realFireSales.length === 0 && env.SITE_ENV !== 'prd' ? await mockFireSales(tours) : realFireSales;
---

<PageLayout
  title={SITE_NAME}
  description={`${SITE_NAME} รวมโปรแกรมทัวร์ต่างประเทศ ${activeCountries
    .slice(0, 5)
    .map((c) => c.nameTh)
    .join(' ')} ราคาชัดเจน เช็กวันเดินทางและที่นั่งว่างได้ทันที สอบถามและจองง่ายผ่าน LINE`}
  path="/"
  ogImage={ogImageUrl(heroCampaign.images[0].src)}
>
  <Hero country={heroCountry} countries={activeCountries} cities={activeCities} />
  {activeCountries.length > 0 && <Destinations countries={activeCountries} />}

  {fireSales.length > 0 && <FireSales entries={fireSales} />}

  {
    featured.length > 0 && (
      <section class="section bg-deco pt-10 md:pt-12">
        <div class="container-site">
          <SectionHeader>
            <Fragment slot="title">ทัวร์ที่<em>กำลังจะออกเดินทาง</em></Fragment>
          </SectionHeader>
          <ul data-reveal-stagger class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
            {
              featured.map((t) => (
                <li class="flex">
                  <TourCard tour={t} columns={4} />
                </li>
              ))
            }
          </ul>
          <div data-reveal class="mt-14 flex justify-center">
            <a href="#destinations" class="btn btn-primary">
              ดูทัวร์ตามประเทศ <Icon name="arrow-right" size={14} />
            </a>
          </div>
        </div>
      </section>
    )
  }

  <PromiseStrip />
  <LineCta />
</PageLayout>
