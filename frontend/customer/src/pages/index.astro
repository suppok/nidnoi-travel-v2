---
import Destinations from '../components/home/Destinations.astro';
import DestinationPicker from '../components/home/DestinationPicker.astro';
import Hero from '../components/home/Hero.astro';
import PromiseStrip from '../components/home/PromiseStrip.astro';
import TourCard from '../components/tour/TourCard.astro';
import Icon from '../components/ui/Icon.astro';
import LineCta from '../components/ui/LineCta.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { heroCampaign } from '../config/home';
import { byNextDeparture, listPublicTours } from '../lib/api/tour-programs';
import { listPublicCountries } from '../lib/api/taxonomy';
import { ogImageUrl } from '../lib/image';
import { SITE_NAME } from '../lib/seo';
import PageLayout from '../layouts/PageLayout.astro';

const FEATURED_LIMIT = 8;

const [countries, tours] = await Promise.all([listPublicCountries(), listPublicTours()]);
const activeCountries = countries.filter((c) => c.tourCount > 0);
const heroCountry = activeCountries.find((c) => c.slug === heroCampaign.countrySlug);
if (!heroCountry) {
  throw new Error(`Home hero links to "${heroCampaign.countrySlug}", which has no active tours — update src/config/home.ts`);
}
const featured = [...tours].sort(byNextDeparture).slice(0, FEATURED_LIMIT);
---

<PageLayout
  title={SITE_NAME}
  description={`${SITE_NAME} รวมโปรแกรมทัวร์ต่างประเทศ ${activeCountries
    .slice(0, 5)
    .map((c) => c.nameTh)
    .join(' ')} ราคาชัดเจน เช็กวันเดินทางและที่นั่งว่างได้ทันที สอบถามและจองง่ายผ่าน LINE`}
  path="/"
  ogImage={ogImageUrl(heroCampaign.image)}
>
  <Hero country={heroCountry} />
  <DestinationPicker countries={activeCountries} />
  <Destinations countries={activeCountries} />

  <section class="section bg-white">
    <div class="container-site">
      <SectionHeader eyebrow="ออกเดินทางเร็ว ๆ นี้">
        <Fragment slot="title">ทัวร์ที่<em>กำลังจะออกเดินทาง</em></Fragment>
      </SectionHeader>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        {
          featured.map((t) => (
            <li class="flex">
              <TourCard tour={t} columns={4} />
            </li>
          ))
        }
      </ul>
      <div class="mt-14 flex justify-center">
        <a href="#destinations" class="btn btn-primary">
          ดูทัวร์ตามประเทศ <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </section>

  <PromiseStrip />
  <LineCta />
</PageLayout>
