// Workers static assets only — no Worker script
{
  "name": "customer",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "env": {
    "dev": { "name": "customer-dev" },
    "prd": { "name": "customer-prd" }
  }
}
